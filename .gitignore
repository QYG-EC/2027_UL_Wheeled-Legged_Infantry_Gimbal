# CMake 构建输出
build/
cmake-build-*/
out/

# C/C++ 编译中间产物
*.o
*.d
*.elf
*.hex
*.bin
*.map
*.lst
*.su
*.a
*.so

# CMSIS-DSP 预编译库是工程的必要链接依赖
!Middlewares/ST/ARM/DSP/Lib/
!Middlewares/ST/ARM/DSP/Lib/libarm_cortexM7lfsp_math.a

# STM32CubeMX 相关
mx.scratch
*.bak
!.settings

# IDE 与编辑器配置
/.clangd
.idea/
.vscode/
*.swp
*~
*.log
!sysid/**/*.log

# 调试器配置与日志
*.jlink
*.launch
JLinkLog.txt
*.jdebug.user
Debug.jdebug.user

# Override the global STM32CubeIDE Debug/ rule for source files.
!User_File/System/debug/
!User_File/System/debug/**

# 操作系统级缓存
.DS_Store
Thumbs.db

# 本地工作记录与 WorkBuddy 缓存
/框架可靠性验证方案.md
/框架修复清单.md
/.workbuddy/

# Pitch实验原始证据和本机调参文件（保留本地，不提交采集产物）
/sysid/pitch/runs/
/sysid/pitch/results/
/sysid/pitch/K_latest.txt
/sysid/pitch/K_latest.txt.tmp
/sysid/pitch/**/__pycache__/

/sysid/pitch/K_external_imu.txt
/sysid/pitch/K_external_imu.txt.tmp

# Yaw辨识原始证据与MATLAB自动保存
/sysid/yaw/runs/
/sysid/yaw/results/
/sysid/yaw/K_latest.txt
/sysid/yaw/**/__pycache__/
*.asv
